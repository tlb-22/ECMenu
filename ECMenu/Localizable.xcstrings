{
  "sourceLanguage": "en",
  "strings": {
    "Choose a regular file as the template.": {
      "comment": "A file template must be an ordinary file",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a regular file as the template."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择普通文件作为模板。"
          }
        }
      }
    },
    "Drag to reorder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整顺序"
          }
        }
      }
    },
    "Drag to reorder. Use the Up and Down arrow keys to move this item.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Use the Up and Down arrow keys to move this item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整顺序，也可使用上下方向键移动此项。"
          }
        }
      }
    },
    "Enter a display name.": {
      "comment": "Validation message for an empty file-template display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a display name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入显示名。"
          }
        }
      }
    },
    "Enter a single file name, without a folder path.": {
      "comment": "Validation message for an invalid default file name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a single file name, without a folder path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入单个文件名，不包含文件夹路径。"
          }
        }
      }
    },
    "Move Down": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下移"
          }
        }
      }
    },
    "Move Up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上移"
          }
        }
      }
    },
    "Reorder %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整“%@”的顺序"
          }
        }
      }
    },
    "The file template library could not be read.": {
      "comment": "The file-template index contains invalid data",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file template library could not be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件模板库。"
          }
        }
      }
    },
    "The file template library uses an unsupported format.": {
      "comment": "The stored file-template format version is unsupported",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file template library uses an unsupported format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件模板库使用了不受支持的格式。"
          }
        }
      }
    },
    "This file template no longer exists.": {
      "comment": "The selected file template has been removed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file template no longer exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件模板已不存在。"
          }
        }
      }
    },
    "alert.command.confirm": {
      "comment": "Dismisses a context-command error alert",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "alert.command.title": {
      "comment": "Title shared by context-command error alerts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation Couldn’t Be Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.all.counted": {
      "comment": "All processed images have date-attribute problems",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The images were compressed, but the date attributes of %lld images couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已压缩但遇到问题：%lld 张图片的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.all.named": {
      "comment": "The named image was compressed, but its dates could not be updated",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was compressed, but its date attributes couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已压缩但遇到问题：“%@”的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.partial.counted": {
      "comment": "Some processed images have date-attribute problems",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images were compressed, but the date attributes of %lld images couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片已压缩但遇到问题：%lld 张图片的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.partial.named": {
      "comment": "The named image has a date-attribute problem while other images completed normally",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images were compressed, but the date attributes of “%@” couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片已压缩但遇到问题：“%@”的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.readPermission.all.counted": {
      "comment": "The selected source images cannot be read",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress the selected images because %lld images can’t be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩图片：%lld 张图片没有读取权限。"
          }
        }
      }
    },
    "alert.imageCompression.readPermission.all.named": {
      "comment": "The named source image cannot be read",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress “%@” because it can’t be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩“%@”：没有读取权限。"
          }
        }
      }
    },
    "alert.imageCompression.readPermission.partial.counted": {
      "comment": "Some source images cannot be read while other images succeeded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because %lld images can’t be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：%lld 张图片没有读取权限。"
          }
        }
      }
    },
    "alert.imageCompression.readPermission.partial.named": {
      "comment": "The named source image cannot be read while other images succeeded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because “%@” can’t be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：“%@”没有读取权限。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.all.counted": {
      "comment": "The output folders for the selected images are not writable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress the selected images because the output folders for %lld images aren’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩图片：%lld 张图片的输出文件夹无法写入。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.all.named": {
      "comment": "The output folder for the named image is not writable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress “%@” because its output folder isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩“%@”：输出文件夹无法写入。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.partial.counted": {
      "comment": "Some image output folders are not writable while other images succeeded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because the output folders for %lld images aren’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：%lld 张图片的输出文件夹无法写入。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.partial.named": {
      "comment": "The output folder for the named image is not writable while other images succeeded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because the output folder for “%@” isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：“%@”的输出文件夹无法写入。"
          }
        }
      }
    },
    "alert.newFile.writePermission.named": {
      "comment": "A file could not be created in the named directory",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create a file because “%@” isn’t writable."
